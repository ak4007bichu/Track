name: BingX Tracker Alert

on:
  schedule:
    # Runs every 5 minutes. You can change this: ('*' means every)
    # Format: Minute Hour Day Month DayOfWeek
    - cron: '*/5 * * * *'
  workflow_dispatch: # Allows you to run it manually

jobs:
  track:
    runs-on: ubuntu-latest
    steps:
      - name: Check out code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.x'

      - name: Install dependencies
        run: pip install requests pycryptodome

      - name: Run BingX Tracker
        env:
          BINGX_API_KEY: ${{ secrets.BINGX_API_KEY }}
          BINGX_SECRET_KEY: ${{ secrets.BINGX_SECRET_KEY }}
          TRADER_UID: ${{ secrets.TRADER_UID }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python bingx_tracker_script.py
